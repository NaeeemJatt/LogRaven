# LogRaven — Production environment template
#
# Copy to `.env` next to docker-compose.prod.yml and fill in every REQUIRED
# value. Values already set inside docker-compose.prod.yml (DATABASE_URL,
# REDIS_URL, storage paths, pipeline flags) do not belong here.

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Strong random string, 32+ chars. Generate:  openssl rand -hex 32
JWT_SECRET_KEY=

# Password for the bundled PostgreSQL container. Generate:  openssl rand -hex 16
POSTGRES_PASSWORD=

# Cloud AI provider API key (investigations + compliance grading)
GEMINI_API_KEY=

# ── Domain / URLs ────────────────────────────────────────────────────────────

# Public URL of the app — used in emails (verify / reset links).
# With the bundled nginx this is the EC2 public address or your domain.
FRONTEND_BASE_URL=http://YOUR_DOMAIN_OR_EC2_IP

# Extra CORS origins (comma-separated). Only needed if the frontend is served
# from a different origin than the API (not the case with the bundled nginx).
CORS_ALLOWED_ORIGINS=

# Set true once HTTPS is enabled (auth cookies then require TLS).
COOKIE_SECURE=false

# ── Email (SMTP — Amazon SES SMTP endpoint recommended) ──────────────────────
# Leave SMTP_HOST empty to log emails instead of sending (not for production).

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_USE_TLS=true

# ── Storage ──────────────────────────────────────────────────────────────────
# local = shared Docker volume (fine for single-host). s3 = S3 bucket.

STORAGE_BACKEND=local
# Required when STORAGE_BACKEND=s3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1
# S3_BUCKET_NAME=

# ── Compliance (optional) ────────────────────────────────────────────────────
# ExternalId customers must set in their IAM role trust policy (confused-deputy defense)
# AWS_ASSUME_ROLE_EXTERNAL_ID=

# ── Tuning (defaults sized for a 1 GB instance) ──────────────────────────────
UVICORN_WORKERS=2
CELERY_CONCURRENCY=1
