{
  "name": "lograven-frontend",
  "version": "1.0.0",
  "description": "LogRaven — Security Investigation Platform",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:safe": "node -e \"const{execSync:e,spawnSync:s}=require('child_process');try{const r=s('powershell',['-Command','(Get-NetTCPConnection -LocalPort 5173 -ErrorAction SilentlyContinue).OwningProcess'],{encoding:'utf8'});const pid=r.stdout.trim();if(pid&&!isNaN(pid)){console.log('Killing PID '+pid+' on port 5173');e('taskkill /PID '+pid+' /F')}}catch(err){}\" && vite",
    "build": "tsc && vite build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "lint": "eslint src e2e --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.test.{ts,tsx}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" eslint.config.js playwright.config.ts vite.config.ts package.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "e2e": "node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.50.0",
    "axios": "^1.7.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.39",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.10"
  }
}
