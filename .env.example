# ── LogRaven Environment Variables ──────────────────────────────────────────

# Storage — local for dev/testing; s3 for production only
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./local
PUBLIC_API_BASE_URL=http://localhost:8000

# Windows psql fix — disables the pager (prevents 'more' not recognised error)
PAGER=

# Database
DATABASE_URL=postgresql://postgres:lgrpass@lograven-db:5432/lograven

# Redis
REDIS_URL=redis://lograven-redis:6379

# AI — Claude API (client provides their own key)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Auth
# Required: 32+ random characters. Example only; replace before starting the API.
JWT_SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=lograven
JWT_AUDIENCE=lograven-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set true when serving API over HTTPS (httpOnly auth cookies)
COOKIE_SECURE=false
# Omit access/refresh from JSON when false (cookies only). Set true for curl/Postman without cookies.
INCLUDE_TOKENS_IN_AUTH_JSON=false
# Rate limits: use X-Forwarded-For client IP (only behind a trusted reverse proxy)
TRUST_FORWARDED_FOR=false

# S3 (only needed when STORAGE_BACKEND=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1
# S3_BUCKET_NAME=lograven-prod
# S3_DOWNLOAD_URL_EXPIRE_SECONDS=900
# Optional S3-compatible endpoint (MinIO, etc.)
# S3_ENDPOINT_URL=

# OpenAI fallback (optional)
# OPENAI_API_KEY=

# Frontend (Vite): leave empty to use dev-server proxy so /auth and /api hit the API on the same origin (cookies work).
# If set, use API root only (http://127.0.0.1:8000). Do NOT append /api or /api/v1 — paths would double (404 on /api/v1/...).
# VITE_API_URL=  (also read from this repo-root .env by vite.config; frontend/.env overrides when both exist)
# If the API is not on 127.0.0.1:8000, set the proxy target (repo root or frontend/.env):
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Analysis safety caps
# MAX_PARSED_EVENTS_PER_FILE=50000
# MAX_PARSED_EVENTS_PER_INVESTIGATION=100000

# Testing-only: run Celery tasks inline instead of through a worker. Keep false in normal runs.
# CELERY_TASK_ALWAYS_EAGER=false

# Uvicorn-only local dev: auto-start a Celery worker on first analyze if none is running. Use false when a worker runs separately (e.g. docker-compose worker service).
AUTO_START_DEV_WORKER=true
# Run investigation pipeline inside the API process (no Celery worker). Default true for local Windows/Mac; set false with a real worker (Docker sets this false).
USE_ASYNCIO_INVESTIGATION_PIPELINE=true
