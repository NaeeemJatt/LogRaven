# LogRaven .gitignore

# Local storage & scratch — never commit uploads or reports
local/uploads/
local/reports/
local/temp/
local/
temp/
tmp/
scratch/
.scratch/

# Environment files & secrets
.env*
!.env.example
!.env.production.example
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Databases, Celery & Local Caches
*.sqlite
*.sqlite3
*.db
dump.rdb
celerybeat-schedule*
celerybeat.pid
*.pid

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
.hypothesis/

# Node & Frontend
node_modules/
frontend/dist/
dist/
.next/
.nuxt/
coverage/
playwright-report/
blob-report/
playwright/.cache/
test-results/
*.tsbuildinfo
.eslintcache
.stylelintcache
.turbo/

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS & Environment shims
.DS_Store
Thumbs.db
desktop.ini
[Dd]esktop.ini
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/
powershell.bat
**/powershell.bat
*.tmp
*.bak
*.orig
*.rej
*~

# Logs & Test Data
*.log
logs/
test-data/

# Agent & AI Tooling Caches
.agents/
.planning/
planning/
.cursor/
.codex/
.claude/
.gemini/
.impeccable/
.dmux/
.github/skills/
.github/agents/
.github/hooks/
.playwright-mcp/
frontend-mockup/
memory-bank/

# Documentation binaries & manuals
*.pdf
*.pdf