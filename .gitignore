# LogRaven .gitignore

# Local storage — never commit uploads or reports
local/uploads/
local/reports/
local/temp/
local/

# Environment files & secrets
.env
*.env
.env.local
.env.*.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node & Frontend
node_modules/
frontend/dist/
dist/
.next/
.nuxt/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo

# OS & Environment shims
.DS_Store
Thumbs.db
desktop.ini
powershell.bat
**/powershell.bat

# Logs & Test Data
*.log
logs/
test-data/

# Agent & AI Tooling Caches
.agents/
.playwright-mcp/
frontend-mockup/
memory-bank/